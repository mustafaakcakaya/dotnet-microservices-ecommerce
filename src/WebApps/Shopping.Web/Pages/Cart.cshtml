@page
@model CartModel
@{
    ViewData["Title"] = "Sepetim";
    var itemCount = Model.Cart.Items.Sum(item => item.Quantity);
}

<div class="nova-page">
    <div class="nova-container">
        <h1 class="nova-page-title">Sepetim <small>(@itemCount Ürün)</small></h1>

        @if (Model.Cart.Items.Count == 0)
        {
            <div class="nova-empty">
                <p class="fs-5 mb-1">Sepetinizde ürün bulunmuyor.</p>
                <p class="text-secondary mb-4">Beğendiğiniz ürünleri sepete ekleyerek alışverişe başlayabilirsiniz.</p>
                <a class="nova-btn" asp-page="/ProductList">Alışverişe Başla</a>
            </div>
        }
        else
        {
            <div class="nova-two-col">
                <section class="nova-panel">
                    @foreach (var item in Model.Cart.Items)
                    {
                        Model.Products.TryGetValue(item.ProductId, out var product);
                        <div class="nova-line">
                            <a class="nova-line-photo" asp-page="/ProductDetail" asp-route-productId="@item.ProductId">
                                @if (product is not null)
                                {
                                    <partial name="_ProductPhoto" model="product" />
                                }
                                else
                                {
                                    <span class="nova-placeholder fs-6">NOVA</span>
                                }
                            </a>
                            <div>
                                <a class="nova-line-name" asp-page="/ProductDetail" asp-route-productId="@item.ProductId">@item.ProductName</a>
                                <div class="nova-line-meta">Renk: @item.Color</div>
                                <div class="nova-line-meta">Adet: @item.Quantity</div>
                            </div>
                            <div class="nova-line-end">
                                <div class="nova-price">@((item.Price * item.Quantity).ToTl())</div>
                                @if (item.Quantity > 1)
                                {
                                    <div class="nova-line-meta">Birim: @item.Price.ToTl()</div>
                                }
                                <form method="post" asp-page-handler="RemoveFromCart">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button class="nova-remove" type="submit">Sil</button>
                                </form>
                            </div>
                        </div>
                    }
                </section>

                <aside class="nova-panel nova-summary">
                    <h2 class="nova-panel-title">Sipariş Özeti</h2>
                    <div class="nova-summary-row"><span>Ara Toplam</span><span>@Model.Cart.TotalPrice.ToTl()</span></div>
                    <div class="nova-summary-row nova-summary-total"><span>Toplam</span><span>@Model.Cart.TotalPrice.ToTl()</span></div>
                    <a class="nova-btn nova-btn-block" asp-page="/Checkout">Alışverişi Tamamla</a>
                    <a class="nova-btn nova-btn-outline nova-btn-block mt-2" asp-page="/ProductList">Alışverişe Devam Et</a>
                </aside>
            </div>
        }
    </div>
</div>
