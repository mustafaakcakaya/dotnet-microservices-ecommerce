@page
@model CheckoutModel
@{
    ViewData["Title"] = "Ödeme";
}

<div class="nova-page">
    <div class="nova-container">
        <h1 class="nova-page-title">Teslimat ve Ödeme</h1>

        <form method="post" asp-page-handler="Checkout" class="nova-form">
            <div class="nova-two-col">
                <div>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-0"></div>

                    <section class="nova-panel">
                        <h2 class="nova-panel-title">Teslimat Adresi</h2>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Order.FirstName" class="form-label">Ad</label>
                                <input asp-for="Order.FirstName" class="form-control" autocomplete="given-name" />
                                <span asp-validation-for="Order.FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Order.LastName" class="form-label">Soyad</label>
                                <input asp-for="Order.LastName" class="form-control" autocomplete="family-name" />
                                <span asp-validation-for="Order.LastName" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Order.EmailAddress" class="form-label">E-posta</label>
                                <input asp-for="Order.EmailAddress" class="form-control" autocomplete="email" />
                                <span asp-validation-for="Order.EmailAddress" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Order.AddressLine" class="form-label">Adres</label>
                                <input asp-for="Order.AddressLine" class="form-control" autocomplete="street-address" />
                                <span asp-validation-for="Order.AddressLine" class="text-danger"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="Order.Country" class="form-label">Ülke</label>
                                <input asp-for="Order.Country" class="form-control" autocomplete="country-name" />
                                <span asp-validation-for="Order.Country" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Order.State" class="form-label">İl</label>
                                <input asp-for="Order.State" class="form-control" autocomplete="address-level1" />
                                <span asp-validation-for="Order.State" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Order.ZipCode" class="form-label">Posta Kodu</label>
                                <input asp-for="Order.ZipCode" class="form-control" autocomplete="postal-code" />
                                <span asp-validation-for="Order.ZipCode" class="text-danger"></span>
                            </div>
                        </div>
                    </section>

                    <section class="nova-panel">
                        <h2 class="nova-panel-title">Ödeme Bilgileri</h2>
                        <div class="mb-3">
                            <label asp-for="Order.PaymentMethod" class="form-label">Ödeme Yöntemi</label>
                            <select asp-for="Order.PaymentMethod" class="form-select">
                                <option value="1">Kredi Kartı</option>
                                <option value="2">Banka Kartı</option>
                                <option value="3">PayPal</option>
                            </select>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Order.CardName" class="form-label">Kart Üzerindeki İsim</label>
                                <input asp-for="Order.CardName" class="form-control" autocomplete="cc-name" />
                                <span asp-validation-for="Order.CardName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Order.CardNumber" class="form-label">Kart Numarası</label>
                                <input asp-for="Order.CardNumber" class="form-control" autocomplete="cc-number" inputmode="numeric" />
                                <span asp-validation-for="Order.CardNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Order.Expiration" class="form-label">Son Kullanma Tarihi</label>
                                <input asp-for="Order.Expiration" class="form-control" placeholder="AA/YY" autocomplete="cc-exp" />
                                <span asp-validation-for="Order.Expiration" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Order.CVV" class="form-label">CVV</label>
                                <input asp-for="Order.CVV" class="form-control" autocomplete="cc-csc" inputmode="numeric" />
                                <span asp-validation-for="Order.CVV" class="text-danger"></span>
                            </div>
                        </div>
                    </section>
                </div>

                <aside class="nova-panel nova-summary">
                    <h2 class="nova-panel-title">Sipariş Özeti</h2>
                    @foreach (var item in Model.Cart.Items)
                    {
                        <div class="nova-summary-row">
                            <span>@item.ProductName × @item.Quantity</span>
                            <span>@((item.Price * item.Quantity).ToTl())</span>
                        </div>
                    }
                    <div class="nova-summary-row nova-summary-total"><span>Toplam</span><span>@Model.Cart.TotalPrice.ToTl()</span></div>
                    <button class="nova-btn nova-btn-block" type="submit">Siparişi Onayla</button>
                </aside>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
