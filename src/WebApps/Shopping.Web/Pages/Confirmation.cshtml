@page
@model ConfirmationModel
@{
    ViewData["Title"] = "Teşekkürler";
}

<div class="nova-page">
    <div class="nova-container">
        <section class="nova-confirm">
            <h1>@Model.Message</h1>
            <p class="text-secondary mt-3 mb-4">Alışverişe devam edebilir ya da siparişlerinizi takip edebilirsiniz.</p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a class="nova-btn" asp-page="/ProductList">Alışverişe Devam Et</a>
                <a class="nova-btn nova-btn-outline" asp-page="/OrderList">Siparişlerim</a>
            </div>
        </section>
    </div>
</div>
