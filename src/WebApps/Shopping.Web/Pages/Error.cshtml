@page
@model ErrorModel
@{
    ViewData["Title"] = "Hata";
}

<div class="nova-page">
    <div class="nova-container">
        <section class="nova-confirm">
            <h1>Bir hata oluştu</h1>
            <p class="text-secondary mt-3 mb-4">İsteğiniz işlenirken bir sorun çıktı. Lütfen biraz sonra tekrar deneyin.</p>
            @if (Model.ShowRequestId)
            {
                <p class="small text-secondary">İstek No: <code>@Model.RequestId</code></p>
            }
            <a class="nova-btn" asp-page="/Index">Ana Sayfaya Dön</a>
        </section>
    </div>
</div>
