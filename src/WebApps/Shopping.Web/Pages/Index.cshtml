@page
@model IndexModel
@{
    ViewData["Title"] = "Türkiye'nin Dijital Teknoloji Mağazası";
}

<section class="nova-hero">
    <div class="nova-hero-text">
        <h1>Yeni<br />Sezon</h1>
        <p>Akıllı telefonlarda en yeni modeller<br /><strong>şimdi NOVA'da</strong></p>
        <a asp-page="/ProductList">Alışverişe Başla</a>
    </div>
    <div class="nova-hero-media">
        <img src="~/images/banner/banner1.png" alt="Yeni sezon akıllı telefonlar" />
    </div>
</section>

<div class="nova-container">
    <section class="nova-section nova-editorial">
        <figure>
            <a asp-page="/ProductList"><img src="~/images/banner/banner2.png" alt="Öne çıkan telefonlar" /></a>
        </figure>
        <figure>
            <a asp-page="/ProductList"><img src="~/images/banner/banner3.png" alt="Yeni gelenler" /></a>
        </figure>
    </section>

    @if (Model.Categories.Count > 0)
    {
        <section class="nova-section nova-tiles" style="--nova-tile-count: @Math.Min(Model.Categories.Count, 3)">
            @foreach (var tile in Model.Categories)
            {
                <a class="nova-tile" asp-page="/ProductList" asp-route-category="@tile.Name">
                    <div class="nova-tile-photo"><partial name="_ProductPhoto" model="tile.Cover" /></div>
                    <div class="nova-tile-title" lang="en">@tile.Name</div>
                    <div class="nova-tile-subtitle">@tile.ProductCount Ürün</div>
                    <span class="nova-link">Keşfet</span>
                </a>
            }
        </section>
    }

    <section class="nova-section pb-5">
        <h2 class="nova-section-title">Öne Çıkan Ürünler</h2>
        @if (Model.Products.Count == 0)
        {
            <div class="nova-empty">Henüz ürün bulunmuyor.</div>
        }
        else
        {
            <div class="nova-grid">
                @foreach (var product in Model.Products.Take(8))
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        }
    </section>
</div>
