@page
@model OrderDetailModel
@{
    ViewData["Title"] = "Sipariş Detayı";
    var order = Model.Order;
}

<div class="nova-page">
    <div class="nova-container">
        <div class="nova-crumbs text-center mb-2">
            <a asp-page="/Index">Ana Sayfa</a><span class="sep">/</span>
            <a asp-page="/OrderList">Siparişlerim</a><span class="sep">/</span>
            <span>Sipariş Detayı</span>
        </div>
        <h1 class="nova-page-title mb-1">Sipariş Detayı</h1>
        <p class="text-center font-monospace text-secondary mb-4 text-break">@order.Id</p>

        <div class="nova-two-col">
            <section class="nova-panel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="nova-panel-title mb-0">Ürünler</h2>
                    <span class="nova-status @order.Status.BadgeClass()">@order.Status.DisplayName()</span>
                </div>
                <table class="nova-table">
                    <thead>
                        <tr>
                            <th>Ürün</th>
                            <th class="text-center">Adet</th>
                            <th class="text-end">Birim Fiyat</th>
                            <th class="text-end">Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.OrderItems)
                        {
                            <tr>
                                <td>
                                    <a class="nova-line-name" asp-page="/ProductDetail" asp-route-productId="@item.ProductId">
                                        @Model.ProductName(item.ProductId)
                                    </a>
                                </td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.Price.ToTl()</td>
                                <td class="text-end">@((item.Price * item.Quantity).ToTl())</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="nova-summary-row nova-summary-total"><span>Toplam</span><span>@Model.Total.ToTl()</span></div>
            </section>

            <aside>
                <section class="nova-panel">
                    <h2 class="nova-panel-title">Teslimat Adresi</h2>
                    <address class="mb-0">
                        <strong>@order.ShippingAddress.FirstName @order.ShippingAddress.LastName</strong><br />
                        @order.ShippingAddress.AddressLine<br />
                        @order.ShippingAddress.ZipCode @order.ShippingAddress.State, @order.ShippingAddress.Country<br />
                        <span class="text-secondary">@order.ShippingAddress.EmailAddress</span>
                    </address>
                </section>
                <section class="nova-panel">
                    <h2 class="nova-panel-title">Ödeme</h2>
                    <p class="mb-0">Kartın son 4 hanesi <span class="font-monospace">@order.Payment.CardLast4</span></p>
                </section>
            </aside>
        </div>
    </div>
</div>
