@page
@model OrderListModel
@{
    ViewData["Title"] = "Siparişlerim";
}

<div class="nova-page">
    <div class="nova-container">
        <h1 class="nova-page-title">Siparişlerim <small>(@Model.Orders.Count Sipariş)</small></h1>

        @if (Model.Orders.Count == 0)
        {
            <div class="nova-empty">
                <p class="fs-5 mb-1">Henüz siparişiniz bulunmuyor.</p>
                <p class="text-secondary mb-4">Tamamlanan siparişleriniz burada görünür.</p>
                <a class="nova-btn" asp-page="/ProductList">Alışverişe Başla</a>
            </div>
        }
        else
        {
            <section class="nova-panel">
                <div class="table-responsive">
                    <table class="nova-table">
                        <thead>
                            <tr>
                                <th>Sipariş No</th>
                                <th>Alıcı</th>
                                <th>Teslimat Adresi</th>
                                <th>Durum</th>
                                <th class="text-end">Tutar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td>
                                        <a class="font-monospace" asp-page="/OrderDetail" asp-route-id="@order.Id">@order.Id</a>
                                    </td>
                                    <td>
                                        <div>@order.ShippingAddress.FirstName @order.ShippingAddress.LastName</div>
                                        <small class="text-secondary">@order.ShippingAddress.EmailAddress</small>
                                    </td>
                                    <td>@order.ShippingAddress.AddressLine, @order.ShippingAddress.State</td>
                                    <td><span class="nova-status @order.Status.BadgeClass()">@order.Status.DisplayName()</span></td>
                                    <td class="text-end fw-semibold">@order.OrderItems.Sum(item => item.Price * item.Quantity).ToTl()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </div>
</div>
