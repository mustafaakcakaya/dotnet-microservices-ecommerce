@page
@model OrderListModel
@{
    ViewData["Title"] = "Orders";
}

<div class="mb-4">
    <p class="text-success fw-semibold mb-1">History</p>
    <h1 class="mb-0">Your orders</h1>
</div>

@if (Model.Orders.Count == 0)
{
    <div class="empty-state text-center rounded-4 border p-5">
        <h2 class="h4">No orders yet</h2>
        <p class="text-secondary">Completed checkouts will appear here.</p>
        <a class="btn btn-success" asp-page="/ProductList">Start shopping</a>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Shipping address</th>
                        <th>Status</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@order.OrderName</div>
                                <small class="text-secondary">@order.Id</small>
                            </td>
                            <td>
                                <div>@order.ShippingAddress.FirstName @order.ShippingAddress.LastName</div>
                                <small class="text-secondary">@order.ShippingAddress.EmailAddress</small>
                            </td>
                            <td>@order.ShippingAddress.AddressLine, @order.ShippingAddress.State</td>
                            <td><span class="badge text-bg-secondary">@order.Status</span></td>
                            <td class="text-end fw-semibold">
                                @order.OrderItems.Sum(item => item.Price * item.Quantity).ToString("C")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
