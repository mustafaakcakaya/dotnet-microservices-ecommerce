@page
@model ProductDetailModel
@{
    ViewData["Title"] = Model.Product.Name;
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="/ProductList">Products</a></li>
        <li class="breadcrumb-item active">@Model.Product.Name</li>
    </ol>
</nav>

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="row g-0">
        <div class="col-lg-6 bg-light p-4 p-lg-5 d-flex align-items-center justify-content-center">
            <img class="img-fluid product-detail-image"
                 src="~/images/product/@Model.Product.ImageFile"
                 onerror="this.onerror=null;this.src='/images/placeholder.png';"
                 alt="@Model.Product.Name" />
        </div>
        <div class="col-lg-6">
            <div class="card-body p-4 p-lg-5">
                <p class="text-success fw-semibold text-uppercase">@string.Join(" · ", Model.Product.Category)</p>
                <h1 class="display-6 fw-bold">@Model.Product.Name</h1>
                <p class="lead text-secondary">@Model.Product.Description</p>
                <p class="display-6 fw-semibold my-4">@Model.Product.Price.ToString("C")</p>

                <form method="post" asp-page-handler="AddToCart" class="row g-3">
                    <input type="hidden" name="productId" value="@Model.Product.Id" />
                    <div class="col-sm-7">
                        <label asp-for="Color" class="form-label"></label>
                        <select asp-for="Color" class="form-select">
                            <option>Black</option>
                            <option>White</option>
                            <option>Red</option>
                            <option>Blue</option>
                        </select>
                    </div>
                    <div class="col-sm-5">
                        <label asp-for="Quantity" class="form-label"></label>
                        <input asp-for="Quantity" class="form-control" min="1" max="100" />
                    </div>
                    <div class="col-12">
                        <button class="btn btn-success btn-lg w-100" type="submit">Add to cart</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
