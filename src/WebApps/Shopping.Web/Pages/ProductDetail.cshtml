@page
@model ProductDetailModel
@{
    var product = Model.Product;
    var category = product.Category.FirstOrDefault();
    ViewData["Title"] = product.Name;
    string[] colors = ["Siyah", "Beyaz", "Kırmızı", "Mavi"];
}

<div class="nova-detail">
    <div class="nova-container">
        <div class="nova-crumbs">
            <a asp-page="/Index">Ana Sayfa</a><span class="sep">/</span>
            @if (category is not null)
            {
                <a asp-page="/ProductList" asp-route-category="@category">@category</a><span class="sep">/</span>
            }
            <span>@product.Name</span>
        </div>

        <div class="nova-detail-grid">
            <div class="nova-gallery">
                <div class="nova-gallery-photo"><partial name="_ProductPhoto" model="product" /></div>
            </div>

            <div class="nova-buybox">
                <h1>@product.Name</h1>
                <p class="nova-subtitle">@product.Description</p>
                <div class="nova-price">@product.Price.ToTl()</div>

                <form method="post" asp-page-handler="AddToCart">
                    <input type="hidden" name="productId" value="@product.Id" />

                    <p class="nova-option-label">Renk: <strong data-selected-color>@Model.Color</strong></p>
                    <div class="nova-options">
                        @foreach (var color in colors)
                        {
                            var id = $"color-{Array.IndexOf(colors, color)}";
                            <input type="radio" id="@id" name="Color" value="@color" checked="@(color == Model.Color)" />
                            <label for="@id">@color</label>
                        }
                    </div>

                    <p class="nova-option-label">Adet</p>
                    <input class="nova-qty" type="number" name="Quantity" value="@Model.Quantity" min="1" max="100" aria-label="Adet" />

                    <button class="nova-btn nova-btn-block" type="submit">Sepete Ekle</button>
                </form>

                <div class="nova-info">
                    <h2>Ürün Bilgileri</h2>
                    <p>@product.Description</p>
                    @if (product.Category.Count > 0)
                    {
                        <p class="mt-2">Kategori: @string.Join(", ", product.Category)</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Keep "Renk: ..." in step with the chosen swatch.
        document.querySelectorAll('input[name="Color"]').forEach(input =>
            input.addEventListener('change', () =>
                document.querySelector('[data-selected-color]').textContent = input.value));
    </script>
}
