@page
@model ProductListModel
@{
    ViewData["Title"] = "Products";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item active">Products</li>
    </ol>
</nav>

<div class="row g-4">
    <aside class="col-lg-3">
        <div class="card border-0 shadow-sm sticky-lg-top category-panel">
            <div class="card-body">
                <h1 class="h5">Categories</h1>
                <div class="list-group list-group-flush">
                    <a asp-page="/ProductList"
                       class="list-group-item list-group-item-action @(string.IsNullOrWhiteSpace(Model.Category) ? "active" : null)">
                        All products
                    </a>
                    @foreach (var category in Model.Categories)
                    {
                        <a asp-page="/ProductList"
                           asp-route-category="@category"
                           class="list-group-item list-group-item-action @(string.Equals(Model.Category, category, StringComparison.OrdinalIgnoreCase) ? "active" : null)">
                            @category
                        </a>
                    }
                </div>
            </div>
        </div>
    </aside>

    <section class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h3 mb-0">@(Model.Category ?? "All products")</h2>
            <span class="text-secondary">@Model.Products.Count item(s)</span>
        </div>

        @if (Model.Products.Count == 0)
        {
            <div class="alert alert-info">No products match this category.</div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var product in Model.Products)
                {
                    <div class="col-md-6 col-xl-4">
                        <partial name="_ProductCard" model="product" />
                    </div>
                }
            </div>
        }
    </section>
</div>
