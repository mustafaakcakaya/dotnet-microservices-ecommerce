<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | NOVA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Jost:wght@300;400;500;600&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="nova-topbar">
        <div class="nova-container">
            <a asp-page="/OrderList">Sipariş Takibi</a>
            <a asp-page="/Contact">İletişim</a>
            <span class="nova-lang">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18" />
                </svg>
                TR
            </span>
        </div>
    </div>

    <header class="nova-header">
        <div class="nova-container nova-header-row">
            <a class="nova-logo" asp-page="/Index" aria-label="NOVA ana sayfa">NOVA</a>
            <div class="nova-header-actions">
                <a class="nova-header-action" asp-page="/OrderList">
                    <span class="nova-icon-wrap">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                            <circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" />
                        </svg>
                    </span>
                    <span>Siparişlerim</span>
                </a>
                @await Component.InvokeAsync("CartSummary")
            </div>
        </div>
    </header>

    @await Component.InvokeAsync("CategoryNav")

    <main class="nova-main">
        @RenderBody()
    </main>

    <footer class="nova-footer">
        <div class="nova-container">
            <div class="nova-footer-grid">
                <div>
                    <h2>NOVA Hakkında</h2>
                    <ul>
                        <li><a asp-page="/Contact">İletişim</a></li>
                        <li><a asp-page="/Privacy">Kişisel Verilerin Korunması</a></li>
                    </ul>
                </div>
                <div>
                    <h2>Müşteri Hizmetleri</h2>
                    <ul>
                        <li><a asp-page="/Contact">Bize Sorun</a></li>
                        <li><a asp-page="/OrderList">Sipariş Takibi</a></li>
                    </ul>
                </div>
                <div>
                    <h2>Hesabım</h2>
                    <ul>
                        <li><a asp-page="/OrderList">Siparişlerim</a></li>
                        <li><a asp-page="/Cart">Sepetim</a></li>
                    </ul>
                </div>
                <div>
                    <h2>Alışveriş</h2>
                    <ul>
                        <li><a asp-page="/ProductList">Tüm Ürünler</a></li>
                    </ul>
                </div>
                <div class="nova-footer-brand">
                    <span class="nova-logo nova-logo-light">NOVA</span>
                </div>
            </div>
            <div class="nova-footer-bottom">
                <span>&copy; @DateTime.UtcNow.Year NOVA, Tüm Hakları Saklıdır</span>
                <span>TR</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
