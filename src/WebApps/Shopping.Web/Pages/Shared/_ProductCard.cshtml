@model ProductModel

<article class="card product-card h-100 border-0 shadow-sm">
    <a asp-page="/ProductDetail" asp-route-productId="@Model.Id" class="product-image-wrap">
        <img class="card-img-top product-image"
             src="~/images/product/@Model.ImageFile"
             onerror="this.onerror=null;this.src='/images/placeholder.png';"
             alt="@Model.Name" />
    </a>
    <div class="card-body d-flex flex-column">
        <div class="small text-uppercase text-secondary mb-2">@string.Join(" · ", Model.Category)</div>
        <h2 class="h5 card-title">
            <a class="text-decoration-none text-dark" asp-page="/ProductDetail" asp-route-productId="@Model.Id">
                @Model.Name
            </a>
        </h2>
        <p class="card-text text-secondary product-description">@Model.Description</p>
        <div class="d-flex align-items-center justify-content-between mt-auto gap-3">
            <strong class="fs-5">@Model.Price.ToString("C")</strong>
            <form method="post" asp-page-handler="AddToCart">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button class="btn btn-success" type="submit">Add to cart</button>
            </form>
        </div>
    </div>
</article>
