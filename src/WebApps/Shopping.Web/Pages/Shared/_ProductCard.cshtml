@model ProductModel

<article class="nova-card">
    <div class="nova-card-photo">
        <a class="stretched-link-photo d-flex align-items-center justify-content-center w-100 h-100"
           asp-page="/ProductDetail" asp-route-productId="@Model.Id" aria-label="@Model.Name">
            <partial name="_ProductPhoto" model="Model" />
        </a>
        <form method="post" asp-page-handler="AddToCart">
            <input type="hidden" name="productId" value="@Model.Id" />
            <button class="nova-card-cart" type="submit" aria-label="@Model.Name sepete ekle">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                    <path d="M5 8h14l-1.2 12H6.2L5 8Z" /><path d="M9 8V6.5a3 3 0 0 1 6 0V8" />
                </svg>
            </button>
        </form>
    </div>
    <div class="nova-card-body">
        <a class="nova-card-brand" asp-page="/ProductDetail" asp-route-productId="@Model.Id">@Model.Name</a>
        <p class="nova-card-name">@Model.Description</p>
        <div class="nova-price">@Model.Price.ToTl()</div>
    </div>
</article>
